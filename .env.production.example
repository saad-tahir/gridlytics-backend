# The server's settings for a hosted copy of Gridlytics (plan Part 10.3; round 7, audit parity-architecture-02): the API in the container (Dockerfile), the
# web app on Vercel. docs/DEPLOY.md, The server's environment, says what each one does.
# On the server, copy this file to .env.production (git-ignored), fill it in there, keep it readable by the owner only, and give it to the container:
# docker run --env-file .env.production ..., or deploy/docker-compose.yml's env_file. Never commit the filled-in copy, and never put any of its values in
# the web app's settings (gridlytics-frontend's frontend/.env.example): every VITE_ value is written into the page for anyone to read.
#
# A line written NAME=value is set (a secret is left empty here, to be made on the server). A line commented out shows the default, which holds while it
# stays so. Make a secret on the server, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------- sign-in
# Preassigned accounts only, in either mode: people are added by the founder console or a company's administrator, with a first password. There is no
# sign-up, no Google or other provider, no magic link and no invitation.
# local (the backend is the sign-in service; accounts, companies and memberships in platform.db) or supabase (the optional mode the owner applies:
# Gridlytics' own Supabase project, never Boxlytics' or Solarlytics'). Never baked into the image. The web app is built with the same VITE_AUTH_MODE.
GRIDLYTICS_AUTH_MODE=local
# Local mode: the key the access tokens are signed with, 32 characters or more. The server refuses to start without it once GRIDLYTICS_HOSTS names a host
# other than this machine; on this machine alone one is made and kept in <data folder>/platform.secret.
GRIDLYTICS_LOCAL_JWT_SECRET=
# Supabase mode only (supabase/README.md, The keys): the project's https address and its anon (publishable) key, the same as the web app's
# GRIDLYTICS_SUPABASE_URL=https://<project ref>.supabase.co
# GRIDLYTICS_SUPABASE_ANON_KEY=
# The service-role key, on the server only: never in the web app, a VITE_ setting or a commit. The founder console makes the accounts with it (the
# project's Admin API)
# GRIDLYTICS_SUPABASE_SERVICE_ROLE_KEY=
# Only while the project signs its tokens with the legacy JWT secret; with its signing keys (JWKS) leave it out
# GRIDLYTICS_SUPABASE_JWT_SECRET=
# GRIDLYTICS_JWT_AUDIENCE=authenticated
# Seconds the project's public keys are kept, and a person's companies and memberships read from the project
# GRIDLYTICS_JWKS_TTL=600
# GRIDLYTICS_MEMBERSHIP_TTL=60

# ---------------------------------------------------------------- the founder console (/admin); it answers 503 until all four are set
GRIDLYTICS_FOUNDER_USERNAME=
# python -m gridlytics.founder hash (asks for the password twice; PBKDF2). Paste it as printed, $ signs and all, with no quotes: docker run --env-file
# keeps quotes as part of the value. In a shell, or in a compose file's environment: block, single quotes instead (docs/DEPLOY.md, The founder console).
GRIDLYTICS_FOUNDER_PASSWORD_HASH=
# python -m gridlytics.founder totp-secret (Base32, with the otpauth:// link for the authenticator app)
GRIDLYTICS_FOUNDER_TOTP_SECRET=
# python -m gridlytics.founder session-secret: the key of the console's 8-hour sessions, Gridlytics' own, made new; changing it ends them all
GRIDLYTICS_FOUNDER_SESSION_SECRET=

# ---------------------------------------------------------------- hosts, the web app's origin, the proxy
# The API's host names, comma-separated: any other Host header is refused
GRIDLYTICS_HOSTS=api.grid.example.com
# The web app's origins, which may call the API from the browser: comma-separated or a JSON array, never *
GRIDLYTICS_CORS_ORIGINS=https://grid.example.com
# Vercel's previews, as one pattern a whole origin matches. Best set on the staging API only, with the previews built against it
# GRIDLYTICS_CORS_ORIGIN_REGEX=https://gridlytics-[a-z0-9-]+-<team slug>\.vercel\.app
# The only address whose X-Forwarded-Proto and X-Forwarded-For uvicorn believes: where the TLS proxy's connections reach the API from. With
# deploy/docker-compose.yml and the proxy on the host, the compose network's gateway (172.30.61.1); with docker run on Docker's default network, its
# gateway (172.17.0.1, docker network inspect bridge); with the API run on the host itself, 127.0.0.1. Never *
FORWARDED_ALLOW_IPS=172.30.61.1
# The sign-in lockouts count tries by the address the proxy gives; without this, every try through the proxy counts under one address
GRIDLYTICS_TRUST_PROXY=1
# The port inside the container
# GRIDLYTICS_PORT=8061

# ---------------------------------------------------------------- files (the image keeps them all on the /data volume)
# The data folder: platform.db (the companies and, in local mode, the accounts), platform.secret, companies/ (each company's workspace and telemetry
# files), keys/ (the sites' signing keys), reports/, backup/ and logs/
# GRIDLYTICS_DATA_DIR=/data
# The default workspace database, which holds no company's work on a hosted copy
# GRIDLYTICS_DB=/data/gridlytics.db
# A copy of every database (with its keys and reports) once a day, the last 14 kept (the image sets 1)
# GRIDLYTICS_DAILY_BACKUP=1
# A copy before a workspace's settings are put back to the shipped ones
# GRIDLYTICS_RESET_BACKUP=1
# The error log, logs/gridlytics.log in the data folder (0 turns it off)
# GRIDLYTICS_LOGS=1
# A built web app (gridlytics-frontend's frontend/dist) for the API to serve on its own host as well. Unset, as here, the API serves no page: the web app
# is on Vercel. The release folder's run.py sets it to its own copy
# GRIDLYTICS_WEB_DIST=

# ---------------------------------------------------------------- the 15-minute loop
# 1 runs the scheduler (the plans every 15 minutes, the alerts, the nightly jobs) in this process. The image sets it; exactly one process per data folder
# may: a second container on the same volume must not
# GRIDLYTICS_SCHEDULER=1
# How many sites a company's tick solves at once, 1 to 8; unset, one fewer than the machine's cores, 1 to 4
# GRIDLYTICS_TICK_WORKERS=
# An https address a record of each failed tick is posted to (an error tracker's webhook); the record names the site and the error's kind only
# GRIDLYTICS_ERROR_WEBHOOK=

# ---------------------------------------------------------------- limits and switches
# Requests a minute: per person signed in, per address, and per address to the public paths without a session; 0 turns one off
# GRIDLYTICS_RATE_USER=6000
# GRIDLYTICS_RATE_ADDRESS=20000
# GRIDLYTICS_RATE_PUBLIC=1200
# Sign-ins from one address in 5 minutes, whatever the email; and reports a company may generate in an hour
# GRIDLYTICS_RATE_SIGN_IN=30
# GRIDLYTICS_RATE_REPORTS=30
# Requests for access the contact page may send from one address in an hour (a request to the founder, never an account)
# GRIDLYTICS_RATE_ACCESS_REQUESTS=5
# 1 opens the interactive API pages at /docs; leave it off on a hosted copy
# GRIDLYTICS_DOCS=0
# The demo sites a company's administrator may load from Fleet (never into a live company): days of generated history, and how often in hours that
# history re-plans within a day
# GRIDLYTICS_DEMO_DAYS=21
# GRIDLYTICS_DEMO_REPLAN_HOURS=3
